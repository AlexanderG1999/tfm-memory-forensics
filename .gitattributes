# Normalize text files
* text=auto

# Source code
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf

# Documentation and configuration
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.cff  text eol=lf

# Structured text/data
*.csv  text eol=lf

# Windows scripts
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.xlsx binary
*.xls  binary